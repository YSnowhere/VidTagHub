{
  "name": "vidtaghub",
  "version": "0.1.0",
  "private": true,
  "description": "对本地视频、图片进行分类管理的桌面软件",
  "author": "vidtaghub",
  "main": "build/electron/main.js",
  "homepage": "./",
  "scripts": {
    "start": "craco start",
    "build": "craco build && tsc -p electron/tsconfig.json",
    "dev": "tsc -p electron/tsconfig.json && concurrently -k -s first \"craco start\" \"wait-on http://localhost:3000 && cross-env ELECTRON_START_URL=http://localhost:3000 electron .\"",
    "dist": "pnpm build && electron-builder --win nsis"
  },
  "dependencies": {
    "@fluentui/react-components": "^9.54.5",
    "@fluentui/react-icons": "^2.0.240",
    "@reduxjs/toolkit": "^2.2.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-redux": "^9.1.2"
  },
  "devDependencies": {
    "@craco/craco": "^7.1.0",
    "@types/node": "^20.14.15",
    "@types/react": "^18.3.4",
    "@types/react-dom": "^18.3.0",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "electron": "^31.7.7",
    "electron-builder": "^24.13.3",
    "react-scripts": "5.0.1",
    "typescript": "^4.9.5",
    "wait-on": "^7.2.0"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "build": {
    "appId": "com.vidtag.hub",
    "productName": "VidTagHub",
    "extends": null,
    "directories": {
      "output": "release"
    },
    "files": [
      "build/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "VidTagHub"
    }
  }
}